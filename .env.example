# Vite otomatik yüklemez; kopyalayın:  copy .env.example .env
# Oluşan .env git’e eklenmez.

# --- CoreService — launchSettings.json / CoreService.http ---
#   @CoreService_HostHttps = https://localhost:7001
#   @CoreService_HostHttp  = http://localhost:5293
# İstekler: {VITE_API_BASE_URL}/api/v1/contact, …/api/v1/content/site?locale=tr
# Mutlak URL’de sadece origin yazsanız bile (/api yok) httpClient otomatik …/api ekler.

# Doğrudan CoreService (CORS: appsettings.Development.json → Cors:AllowedOrigins)
VITE_API_BASE_URL=https://localhost:7001
# VITE_API_BASE_URL=http://localhost:5293

# Vite dev’de proxy: tarayıcı /api → CoreService (yukarıdaki mutlak yerine)
# VITE_API_BASE_URL=/api
# VITE_DEV_PROXY_TARGET=https://localhost:7001
# VITE_DEV_PROXY_TARGET=http://localhost:5293

# Site paketi + çeviri merge (bootstrapRemoteContent)
VITE_USE_REMOTE_CONTENT=true

# Admin tarih filtre varsayılanı (saat) - başvuru/iletişim/log listeleri için
VITE_ADMIN_DEFAULT_LAST_HOURS=24

# Dark map provider (Mapbox) - token girilirse basvuru sayfasi mapbox dark style kullanir.
# Bos birakilirsa OSM + dark filter fallback devam eder.
# VITE_MAPBOX_PUBLIC_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_MAPBOX_STYLE_ID=dark-v11
